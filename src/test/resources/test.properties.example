# Default test configuration (copy to test.properties — see README).

baseUrl=http://localhost:3000/

# HTTP timeouts in milliseconds.
connectTimeoutMs=10000
socketTimeoutMs=30000

# Logback root level for the test run: all SLF4J loggers inherit this unless you add
# explicit <logger> rules in logback-test.xml. INFO = your log.info visible; DEBUG = log.debug too.
testLogLevel=DEBUG
